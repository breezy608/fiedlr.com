name:               fiedlr
version:            0.3.6
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  other-modules:    BiblioCompiler
                  , PdfCompiler
                  , Helpers
                  , Categories
  build-depends:    base == 4.*
                  , hakyll == 4.17.*
                  , pandoc == 3.11.*
                  , citeproc == 0.13.*
                  , containers == 0.7.*
                  , filepath == 1.5.*
                  , blaze-html == 0.9.*
                  , process == 1.6.*
                  , text == 2.1.*
                  , binary == 0.8.*
                  , bytestring == 0.12.*
  ghc-options:      -threaded
  default-language: Haskell2010
